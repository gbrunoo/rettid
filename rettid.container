[Install]
WantedBy=default.target

[Container]
ContainerName=rettid
DropCapability=ALL
EnvironmentFile=.env
HealthCmd=["wget","--spider","-q","--tries=1","http://localhost:8080/settings"]
HealthInterval=5m
HealthTimeout=3s
# Build your own image from Dockerfile.alpine or Dockerfile.ubuntu and
# reference it here; this fork does not publish a container image.
Image=localhost/rettid:latest
NoNewPrivileges=true
PublishPort=8080:8080
ReadOnly=true
User=nobody
