# supported versions here: https://hub.docker.com/_/rust
ARG RUST_BUILDER_VERSION=slim-bookworm
ARG UBUNTU_RELEASE_VERSION=noble

########################
## builder image
########################
FROM rust:${RUST_BUILDER_VERSION} AS builder

RUN apt-get update \
    && apt-get -y install git build-essential cmake libclang-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /rettid

# download (most) dependencies in their own layer
COPY Cargo.lock Cargo.toml ./
RUN mkdir src && echo "fn main() { panic!(\"why am i running?\") }" > src/main.rs
RUN cargo build --release --locked --bin rettid
RUN rm ./src/main.rs && rmdir ./src

# copy the source and build the rettid binary
COPY . ./
RUN cargo build --release --locked --bin rettid
RUN echo "finished building rettid!"

########################
## release image
########################
FROM ubuntu:${UBUNTU_RELEASE_VERSION} AS release

# The official Ubuntu image ships without wget, which the HEALTHCHECK below
# depends on. Without this the container would always report unhealthy.
RUN apt-get update \
    && apt-get -y install --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

# Import rettid binary from builder
COPY --from=builder /rettid/target/release/rettid /usr/local/bin/rettid

# Add non-root user for running rettid
RUN useradd \
    --no-create-home \
    --password "!" \
    --comment "user for running rettid" \
    rettid
USER rettid

# Rettid's own default: voyager layout/theme out of the box. Override with
# -e REDLIB_DEFAULT_LAYOUT=card (or any REDLIB_DEFAULT_* var) at `docker run`
# time, or via env_file, to get upstream's classic look instead.
ENV REDLIB_DEFAULT_LAYOUT=voyager
ENV REDLIB_DEFAULT_THEME=voyagerDark

# Document that we intend to expose port 8080 to whoever runs the container
EXPOSE 8080

# Run a healthcheck every minute to make sure rettid is functional
HEALTHCHECK --interval=1m --timeout=3s CMD wget --spider -q http://localhost:8080/settings || exit 1

# Add container metadata
LABEL org.opencontainers.image.authors="gbrunoo"

CMD ["rettid"]
